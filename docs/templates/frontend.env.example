# === نما للجمال — Frontend (EasyPanel / Docker build args) ===
# انسخ إلى .env.local للتطوير أو أضف كـ Environment Variables في EasyPanel

# API
NEXT_PUBLIC_API_URL=https://api.sahtk.shop

# Pixels (ويب فقط — التجزئة على الخادم)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# واتساب الدعم (بدون + في الرابط — يُبنى wa.me)
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000

# Upsell
NEXT_PUBLIC_UPSELL_TIMEOUT_MS=12000

# اختياري: Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
